  - m_Id: 27581930718355458
    m_Localized: "\u0412\u0430\u0448 \u0431\u043E\u043D\u0443\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 32670604819927040
    m_Localized: "\u041D\u0430\u0434\u043E\u0435\u043B\u0430 \u0440\u0435\u043A\u043B\u0430\u043C\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 32670604861870080
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u0435 \u0441\u0442\u0430\u0442\u0443\u0441
      \u0412\u0418\u041F \u043D\u0430 30 \u0434\u043D\u0435\u0439 \n\u043D\u0430\u0441\u043B\u0430\u0436\u0434\u0430\u0439\u0442\u0435\u0441\u044C
      \u0438\u0433\u0440\u043E\u0439 \u0431\u0435\u0437 \u0440\u0435\u043A\u043B\u0430\u043C\u044B!"
    m_Metadata:
      m_Items: []
  - m_Id: 32670604861870081
    m_Localized: "\u0412\u042B \u041F\u041E\u0411\u0415\u0414\u0418\u0422\u0415\u041B\u042C!"
    m_Metadata:
      m_Items: []
  - m_Id: 32670604861870082
    m_Localized: "\u0422\u041E\u041F-\u0441\u0442\u0430\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 32670604861870083
    m_Localized: "\u0422\u041E\u041F-\u0444\u0438\u0448\u0435\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 32670604861870084
    m_Localized: "\u041F\u0420\u0410\u0412\u0418\u041B\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 32670604861870085
    m_Localized: "\u0427\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u0444\u0438\u0448\u0435\u043A
      \u0432 \u0434\u0430\u043D\u043D\u043E\u0439 \u043B\u0438\u0433\u0435 \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u043B
      \u0438\u0433\u0440\u043E\u043A, \u0442\u0435\u043C \u0432\u044B\u0448\u0435
      \u043E\u043D \u0431\u0443\u0434\u0435\u0442 \u0432 \u0440\u0435\u0439\u0442\u0438\u043D\u0433\u0435
      \u0434\u0430\u043D\u043D\u043E\u0439 \u043B\u0438\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 32670604861870086
    m_Localized: "\u0415\u0441\u043B\u0438 \u0438\u0433\u0440\u043E\u043A \u043F\u043E\u0442\u0435\u0440\u044F\u0435\u0442
      \u0444\u0438\u0448\u043A\u0438 \u0438 \u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0441\u044F
      \u043D\u0430 \u043B\u0438\u0433\u0443 \u043D\u0438\u0436\u0435, \u0435\u0433\u043E
      \u0440\u0435\u043A\u043E\u0440\u0434 \u0441\u0433\u043E\u0440\u0438\u0442 \u043D\u0430
      \u0434\u043E\u0441\u043A\u0435 \u043B\u0438\u0434\u0435\u0440\u043E\u0432 \u0434\u0430\u043D\u043D\u043E\u0439
      \u043B\u0438\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 32670604861870087
    m_Localized: "\u0418\u0433\u0440\u043E\u043A\u0438 \u0441 \u0412\u0418\u041F-\u0441\u0442\u0430\u0442\u0443\u0441\u043E\u043C
      \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 \u0434\u043E\u0441\u0442\u0443\u043F
      \u043A \u0437\u0430\u043A\u0440\u044B\u0442\u043E\u0439 \u043B\u0438\u0433\u0435
      \u0434\u043B\u044F \u0412\u0418\u041F\u043E\u0432 \u0431\u0435\u0437 \u043B\u0438\u043C\u0438\u0442\u043E\u0432
      \u043D\u0430 \u0441\u0442\u0430\u0432\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 32670604861870088
    m_Localized: "\u0418\u0433\u0440\u043E\u043A\u0438 \u0412\u0418\u041F-\u041B\u0438\u0433\u0438
      \u043C\u043E\u0433\u0443\u0442 \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C
      \u043B\u044E\u0431\u0443\u044E \u043B\u0438\u0433\u0443 \u0434\u043B\u044F
      \u0438\u0433\u0440\u044B \u043E\u043D\u043B\u0430\u0439\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 32670604861870089
    m_Localized: "\u0418\u0433\u0440\u043E\u043A\u0438 \u0441 \u0412\u0418\u041F
      \u0441\u0442\u0430\u0442\u0443\u0441\u043E\u043C \u043C\u043E\u0433\u0443\u0442
      \u0438\u0433\u0440\u0430\u0442\u044C \u0431\u0435\u0437 \u0440\u0435\u043A\u043B\u0430\u043C\u044B"
    m_Metadata:
      m_Items: []
